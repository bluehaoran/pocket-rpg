 "story": {
  "questions": [
   {
    "id": "final",
    "text": "What is the final Minimon? Name and describe it."
   },
   {
    "id": "hard",
    "text": "Why is it so hard to find?"
   },
   {
    "id": "evaded",
    "text": "How has it evaded capture so far?"
   }
  ],
  "segments": [
   {
    "name": "I Choose You!",
    "text": "Roll a location. Start mid-battle against another trainer. The Coach calls out each player's Minimon to show off and deal narrative damage.",
    "tables": [
     "location"
    ]
   },
   {
    "name": "Missile Squad",
    "text": "Two bully trainers with a mean Minimon. Usually not a straight fight: it tests problem-solving.",
    "tables": [
     "npc",
     "rival"
    ]
   },
   {
    "name": "The Legendary",
    "text": "A location mixing the Legendary's domain and the way in. The Coach tries to capture it while the team attacks, defends and ensnares it."
   }
  ]
 },
 "groupFields": [
  {
   "id": "legendary",
   "label": "The final Minimon",
   "kind": "text",
   "generator": "rival"
  }
 ],
