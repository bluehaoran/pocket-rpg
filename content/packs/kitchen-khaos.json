   "label": "Courtier",
   "output": "{npc.personality} {npc.description|lower} {kk.species|lower}"
  }
 ],
 "seed": null,
 "story": {
  "questions": [
   {
    "id": "occasion",
    "text": "What is the big occasion?"
   },
   {
    "id": "uptight",
    "text": "Why is the court so uptight about it?"
   },
   {
    "id": "late",
    "text": "Why haven't you had enough time to prepare?"
   },
   {
    "id": "stakes",
    "text": "What's at stake if the feast goes badly?"
   },
   {
    "id": "ingredient",
    "text": "What rare, nigh-mythical ingredient will you need?"
   },
   {
    "id": "hard",
    "text": "What makes it so hard to obtain?"
   }
  ],
  "segments": [
   {
    "name": "Gathering the Ingredients",
    "text": "The King's Food Chancellor hands out tasks. Prep ingredients under pressure to perform."
   },
   {
    "name": "If You Can't Stand the Heat…",
    "text": "Cooking begins. Some characters are forced into a critical kitchen action."
   },
   {
    "name": "Dinner is Served",
    "text": "The court is served. The King and nobles judge the food, and the consequences follow."
   }
  ]
 },
 "flavour": {
  "roll-for-shoes": {
   "rootSkill": "Do anything",
