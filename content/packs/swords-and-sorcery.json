 "seed": {
  "columns": [
   {
    "label": "Your patron…",
    "table": "seed.patron"
   },
   {
    "label": "Has given you a quest to…",
    "table": "seed.quest",
    "case": "lower"
   },
   {
    "label": "So adventure forth into…",
    "table": "seed.place"
   },
   {
    "label": "But beware…",
    "table": "seed.beware"
   }
  ],
  "template": "{0} has given you a quest to {1}. Adventure forth into {2}, but beware {3}.",
  "dice": "d6 per column"
 },
 "flavour": {
  "lasers-feelings": {
   "checks": [
    {
     "id": "under",
     "label": "Swords",
     "roll": "under",
     "hint": "physicality, fighting, sneaking, intimidation"
    },
    {
     "id": "over",
     "label": "Sorcery",
     "roll": "over",
     "hint": "magic, knowledge, insight, persuasion"
    }
   ],
   "numberRange": [
    2,
    5
   ],
   "numberRoll": {
    "dice": "1d6",
    "reroll": [
     1,
     6
    ],
    "note": "GM may allow choosing instead"
   },
   "fields": [
    {
     "id": "style",
     "label": "Ancestry",
     "kind": "pick-or-text",
     "table": "lf.style"
    },
    {
     "id": "role",
     "label": "Background",
     "kind": "pick",
     "table": "lf.role"
    },
    {
     "id": "number",
     "label": "S&S number",
     "kind": "number",
     "range": [
      2,
      5
     ],
     "randomise": "numberRoll"
    },
    {
     "id": "name",
     "label": "Name",
     "kind": "text",
     "hint": "A cool fantasy adventurer name, like Gunther the Brave",
     "table": "name.fantasy"
    }
   ],
   "derived": [
    {
     "id": "hp",
     "label": "Max HP",
     "formula": "3 * N",
     "note": "0 HP = unconscious; allies get one chance to save you before you die"
    },
    {
     "id": "sp",
     "label": "Max SP (spirit)",
     "formula": "10 - 2 * N",
     "note": "Successful cast reduces SP by spell level"
    },
    {
     "id": "wd",
     "label": "Weapon damage dice",
     "formula": "N - 1",
     "note": "Roll WD d6 on a hit; deal the highest"
    },
    {
     "id": "en",
     "label": "Encumbrance",
     "formula": "N + 3",
     "note": "Items carried/worn"
    },
    {
     "id": "spellsKnown",
     "label": "Spells known",
     "formula": "max SP"
    }
   ],
   "rest": "Night's rest restores all HP and SP.",
   "magic": {
    "roll": "Sorcery (level 1+)",
    "onFail": "Something bad and magical happens.",
    "effectDice": "Roll spell-level d6, take highest; damage/heal = result + 2 * level; may split among close targets.",
    "duration": "Continuous effects last one minute."
   },
   "dice": {
    "base": 1,
    "bonuses": [
     {
      "id": "prepared",
      "label": "Prepared",
      "dice": 1
     },
     {
      "id": "trained",
      "label": "Trained",
      "dice": 1
     }
    ],
    "min": 1,
    "max": 3
   },
   "outcomes": [
    {
     "successes": 0,
     "label": "Goes wrong",
     "text": "GM says how things get worse."
    },
    {
     "successes": 1,
     "label": "Barely",
     "text": "GM inflicts a complication, harm, or cost."
    },
    {
     "successes": 2,
     "label": "Well",
     "text": "You do it well."
    },
    {
     "successes": 3,
     "label": "Critical",
     "text": "GM tells you an extra effect."
    }
   ],
   "exact": {
    "name": "Divine Intervention",
    "countsAsSuccess": true,
    "text": "A deity or otherworldly being gives insight. Ask the GM a question (answered honestly). You may change your action and roll again instead.",
    "questions": "divine.questions",
    "checks": "any"
   },
   "help": {
    "text": "Say how you help and roll. If you succeed, give them +1d."
   },
   "gmGuidance": {
    "conversation": "Describe the scene, introduce a threat, ask what players do; ask for rolls when uncertain.",
    "playerSkill": "Players solve problems themselves; Sorcery is not intelligence.",
    "playersRollOnly": "Monsters have HP and DMG (see monsters table); if players fail they take damage or are put in a worse situation. Enemy spell is a threat by itself; a trap deals monster-equivalent damage."
   },
   "numberLabel": "S&S number",
   "sentence": "{name}\nis {a} {style|lower} {role|lower}"
  }
 }
}
