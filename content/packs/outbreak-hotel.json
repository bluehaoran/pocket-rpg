 ],
 "seed": null,
 "story": {
  "questions": [
   {
    "id": "where",
    "text": "Where is the hotel?"
   },
   {
    "id": "name",
    "text": "What is the hotel called?"
   }
  ],
  "segments": [
   {
    "name": "Checking In",
    "text": "A busy, overwhelming hotel. Vacancies shrink and scenes get more chaotic. Foreshadow: NPCs cough, sneeze, act oddly."
   },
   {
    "name": "The Outbreak",
    "text": "NPCs turn and the hotel is overrun. The PCs are forced together. Run set pieces built on the hotel's hazards."
   },
   {
    "name": "Escape",
    "text": "Give a clear route to safety. NPCs suggest routes; zombies give the cast horrific ends. Final actions are heavily punished or rewarded."
   }
  ],
  "note": "Tie each character to an NPC they worry about. Shared NPCs are better."
 },
 "flavour": {
  "roll-for-shoes": {
   "rootSkill": "Do anything",
   "fields": [
    {
     "id": "name",
     "label": "Name",
     "kind": "text",
     "table": "name.modern"
    },
    {
     "id": "look",
     "label": "Description",
     "kind": "text",
     "generator": "look"
    },
    {
     "id": "reason",
     "label": "Why you're here",
     "kind": "pick-or-text",
     "table": "oh.reason"
    },
    {
     "id": "phobia",
     "label": "Phobia",
     "kind": "pick-or-text",
     "table": "oh.phobia",
     "status": {
      "level": -2,
      "format": "Fear of {v}",
      "optional": true
     },
     "note": "Mostly flavour. The GM may make it a -2 status."
    },
    {
     "id": "worry",
     "label": "NPC you're worried about",
     "kind": "text",
     "generator": "npc"
    }
   ],
   "sentence": "{name}, {look}\n{a} {reason|lower} afraid of {phobia|lower}"
  }
 }
}
