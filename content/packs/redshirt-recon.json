 "story": {
  "questions": [
   {
    "id": "planet",
    "text": "What type of planet is it?"
   },
   {
    "id": "hesitant",
    "text": "What makes the crew hesitant to investigate?"
   },
   {
    "id": "convinced",
    "text": "What finally convinces the Captain to send a team?"
   }
  ],
  "segments": [
   {
    "name": "Mission Briefing",
    "text": "Assemble the team, hand out red shirts, outline the mission. Players suggest obstacles; note them for later. Set a clear goal for once the source is found."
   },
   {
    "name": "Planet Exploration",
    "text": "Track the signal across the surface. Add distractions, including obstacles from the briefing. The leader keeps them on task; reward using their gear.",
    "tables": [
     "npc",
     "danger"
    ]
   },
   {
    "name": "Source Encounter",
    "text": "A hard final confrontation at the source. Use the hesitation from the introduction. Draw on skills gained and weaknesses shown.",
    "tables": [
     "signal",
     "danger"
    ]
   }
  ]
 },
