{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocket-rpg/schemas/common.schema.json",
  "title": "PocketRPG shared definitions",
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
    "tagValue": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true }
      ]
    },
    "entry": {
      "type": "object",
      "required": ["v"],
      "additionalProperties": false,
      "properties": {
        "v": { "type": "string", "minLength": 1 },
        "tags": { "type": "object", "additionalProperties": { "$ref": "#/$defs/tagValue" } },
        "src": { "type": "string" },
        "data": { "type": "object" },
        "position": { "enum": ["before", "after"] }
      }
    },
    "modifierDecl": {
      "type": "object",
      "required": ["label", "values"],
      "properties": {
        "label": { "type": "string" },
        "values": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
        "valueLabels": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "modifierUse": {
      "type": "object",
      "required": ["key"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string" },
        "required": { "type": "boolean" },
        "default": { "type": "string" }
      }
    },
    "provenance": { "type": "object", "properties": { "author": { "type": "string" }, "license": { "type": "string" } } },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
  }
}
