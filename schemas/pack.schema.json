{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pocket-rpg/schemas/pack.schema.json",
  "title": "PocketRPG genre pack",
  "description": "See docs/02-data-model.md §1. Cross-references are checked by src/lib/content/validate.ts.",
  "type": "object",
  "required": ["id", "name", "version", "tables"],
  "additionalProperties": false,
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "name": { "type": "string" },
    "genre": { "type": "string" },
    "version": { "$ref": "common.schema.json#/$defs/version" },
    "library": { "type": "boolean" },
    "nameSetting": { "type": "string" },
    "extends": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/id" } },
    "provenance": { "$ref": "common.schema.json#/$defs/provenance" },
    "setting": { "type": "object", "properties": { "premise": { "type": "string" } } },
    "modifiers": { "type": "object", "additionalProperties": { "$ref": "common.schema.json#/$defs/modifierDecl" } },
    "tables": { "type": "object", "additionalProperties": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/entry" } } },
    "generators": { "type": "array", "items": { "$ref": "#/$defs/generator" } },
    "seed": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["columns", "template"],
          "properties": {
            "columns": {
              "type": "array", "minItems": 1,
              "items": {
                "type": "object", "required": ["label", "table"], "additionalProperties": false,
                "properties": { "label": { "type": "string" }, "table": { "type": "string" }, "case": { "enum": ["lower"] } }
              }
            },
            "template": { "type": "string" }
          }
        }
      ]
    },
    "story": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "questions": {
          "type": "array",
          "items": {
            "type": "object", "required": ["id", "text"], "additionalProperties": false,
            "properties": { "id": { "type": "string" }, "text": { "type": "string" }, "table": { "type": ["string", "null"] } }
          }
        },
        "segments": {
          "type": "array",
          "items": {
            "type": "object", "required": ["name", "text"], "additionalProperties": false,
            "properties": { "name": { "type": "string" }, "text": { "type": "string" }, "tables": { "type": "array", "items": { "type": "string" } } }
          }
        },
        "note": { "type": "string" }
      }
    },
    "groupFields": { "type": "array", "items": { "$ref": "#/$defs/field" } },
    "flavour": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lasers-feelings": { "$ref": "#/$defs/lasersFeelings" },
        "roll-for-shoes": { "$ref": "#/$defs/rollForShoes" }
      }
    }
  },
  "$defs": {
    "generator": {
      "type": "object",
      "required": ["id", "label", "output"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "modifiers": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/modifierUse" } },
        "output": { "type": "string", "minLength": 1 }
      }
    },
    "field": {
      "type": "object",
      "required": ["id", "label", "kind"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "kind": { "enum": ["pick", "pick-or-text", "multi", "number", "text"] },
        "table": { "type": ["string", "null"] },
        "generator": { "type": "string" },
        "examples": { "type": "string" },
        "hint": { "type": "string" },
        "note": { "type": "string" },
        "count": { "type": "integer", "minimum": 1 },
        "range": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
        "randomise": { "type": "string" },
        "skill": { "type": "object", "required": ["level"], "properties": { "level": { "type": "integer", "minimum": 1 } } },
        "status": {
          "type": "object", "required": ["level"],
          "properties": { "level": { "type": "integer" }, "format": { "type": "string" }, "optional": { "type": "boolean" } }
        }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "multi" } } }, "then": { "required": ["count"] } }
      ]
    },
    "lasersFeelings": {
      "type": "object",
      "required": ["checks", "fields"],
      "properties": {
        "checks": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {
            "type": "object", "required": ["id", "label", "roll"],
            "properties": { "id": { "type": "string" }, "label": { "type": "string" }, "roll": { "enum": ["under", "over"] }, "hint": { "type": "string" } }
          }
        },
        "numberRange": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } },
        "dice": {
          "type": "object", "required": ["base", "min", "max"],
          "properties": {
            "base": { "type": "integer", "minimum": 1 },
            "min": { "type": "integer", "minimum": 1 },
            "max": { "type": "integer", "minimum": 1 },
            "bonuses": {
              "type": "array",
              "items": { "type": "object", "required": ["id", "label", "dice"], "properties": { "id": { "type": "string" }, "label": { "type": "string" }, "dice": { "type": "integer" } } }
            }
          }
        },
        "outcomes": {
          "type": "array",
          "items": {
            "type": "object", "required": ["successes", "label"],
            "properties": { "successes": { "type": "integer", "minimum": 0 }, "label": { "type": "string" }, "text": { "type": "string" }, "picks": { "type": "array", "items": { "type": "string" } } }
          }
        },
        "resources": {
          "type": "array",
          "items": { "type": "object", "required": ["id", "label", "start", "max"], "properties": { "start": { "type": "integer" }, "max": { "type": "integer" } } }
        },
        "derived": {
          "type": "array",
          "items": { "type": "object", "required": ["id", "label", "formula"] }
        },
        "sentence": { "type": "string" }
      }
    },
    "rollForShoes": {
      "type": "object",
      "required": ["fields"],
      "additionalProperties": false,
      "properties": {
        "rootSkill": { "type": "string" },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } },
        "sentence": { "type": "string" },
        "starterSkills": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "table": { "type": "string" },
            "count": { "type": "integer", "minimum": 0 },
            "max": { "type": "integer", "minimum": 0 },
            "level": { "type": "integer", "minimum": 1 }
          }
        }
      }
    }
  }
}
